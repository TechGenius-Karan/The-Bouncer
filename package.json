{
  "name": "the-bouncer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck:content-engine": "tsc -p tsconfig.content-engine.json --noEmit",
    "typecheck:netlify-functions": "tsc -p tsconfig.netlify-functions.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:print-rules": "tsx content-engine/scripts/printRuleSplits.ts",
    "content:generate": "tsx content-engine/scripts/generateBatch.ts",
    "content:seed-db": "tsx content-engine/scripts/seedDatabase.ts",
    "content:queue-puzzles": "tsx content-engine/scripts/queuePuzzles.ts",
    "content:schedule": "tsx content-engine/scripts/schedulePuzzles.ts",
    "content:tag-words": "tsx content-engine/scripts/tagWords.ts",
    "dev:functions": "netlify dev",
    "pwa:generate-icons": "pwa-assets-generator"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "mongodb": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "natural": "^8.1.1",
    "netlify-cli": "^27.1.1",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.11",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
