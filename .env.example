# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# MongoDB Atlas connection string (Atlas dashboard → cluster → Connect → Drivers).
# Include a database name in the path, e.g. .../the-bouncer?retryWrites=...
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/the-bouncer?retryWrites=true&w=majority

# Phase 6: shared access code gating the /admin review screen. Pick any
# non-guessable string — there are no individual reviewer accounts, this
# is the only gate.
ADMIN_ACCESS_CODE=

# ai-feedback-plan.md: powers the AI-assisted reject review (netlify/functions/_shared/aiReview.ts).
# Free, no card required — get one at https://aistudio.google.com/apikey.
# Without this set, AI review falls back to a plain reject with no error.
GEMINI_API_KEY=
